{
  "name": "consultio",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "format": "prettier --write \"client/src/**/*.{js,jsx,css}\" \"server/src/**/*.js\" \"server/scripts/**/*.mjs\"",
    "format:check": "prettier --check \"client/src/**/*.{js,jsx,css}\" \"server/src/**/*.js\" \"server/scripts/**/*.mjs\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.9.6"
  }
}
